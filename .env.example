# Copy this file to .env and fill in real values before running the app.

NODE_ENV=development
PORT=3000

# MongoDB connection string (local instance or Atlas cluster).
MONGODB_URI=

# Secret used to sign JWTs. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# This MUST be set to a real secret in production — the app will refuse
# to start in production without it.
JWT_SECRET=

# How long an access token stays valid.
JWT_EXPIRES_IN=8h

# bcrypt cost factor for password hashing (10-12 is a reasonable range).
BCRYPT_SALT_ROUNDS=12

# Origin allowed to call the API with credentials, if you lock CORS down
# beyond the default same-origin dev setup.
CLIENT_ORIGIN=http://localhost:3000
